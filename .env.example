# AutoSecAgent 引擎运行配置 —— 复制为 .env 并填写。
# 采用"单模型端到端"：solver（执行引擎）即所用模型，改 ENGINE_PROVIDER 一行即可切换厂商。

# ══ 执行引擎模型选择（Claude Code 内层引擎指向 Anthropic 兼容端点）══════════════════
# 可选 provider：baidu-glm(百度agent-awd网关,当前主力) / deepseek(备选) / glm(备选)
#
# --- 主力：百度 agent-awd 网关 GLM-5.2（Anthropic 协议）---
AUTOSEC_ENGINE_PROVIDER=baidu-glm
AUTOSEC_ENGINE_API_KEY=<your-baidu-gateway-api-key>
#
# --- 备选：DeepSeek（注释掉上面两行，取消下面两行注释）---
# AUTOSEC_ENGINE_PROVIDER=deepseek
# AUTOSEC_ENGINE_API_KEY=<your-deepseek-api-key>
#
# 显式覆盖端点（一般不用，predefined 由 provider 自动推导）：
# AUTOSEC_ENGINE_BASE_URL=https://agent-awd.baidu.com
# AUTOSEC_ENGINE_MODEL=glm-5.2-agent-chanllenge

# ══ 引擎会话限制 ═══════════════════════════════════════════════════════════════════
AUTOSEC_MAX_TURNS=60               # 单子代理会话轮数上限（防失控）
AUTOSEC_SESSION_SECONDS=900        # 单子代理会话挂钟上限

# ══ 授权与目标（可选，也可走 CLI --auth）══════════════════════════════════════════
# AUTOSEC_AUTH_FILE=auth.yaml
# AUTOSEC_AUTH_REQUIRED=true

# ══ 止损（借鉴 hxbai stoploss）════════════════════════════════════════════════════
# AUTOSEC_TIME_BUDGET_SEC=900
# AUTOSEC_TARGET_BUDGET_SEC=3600
# AUTOSEC_NO_OUTPUT_ROUNDS=5